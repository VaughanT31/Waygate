{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Waygate",
  "version": "0.1.0",
  "identifier": "com.ctrlshiftzed.waygate",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Waygate",
        "width": 1600,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 680,
        "center": true,
        "backgroundColor": "#0b0913"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; media-src 'self'; font-src 'self'; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
